# Optional. If empty, ZentSSH generates /data/master.key on first start.
# To supply your own: openssl rand -base64 32 | tr -d '\n'
# IMPORTANT: an explicitly configured but invalid MASTER_KEY aborts startup.
MASTER_KEY=

# One-time token for creating the first administrator. If empty on a fresh
# database, ZentSSH generates a random token and prints it to the container log.
SETUP_TOKEN=

ZENTSSH_PORT=8080
TZ=Europe/Berlin

# Default uses a Docker named volume so first start also works with the
# unprivileged container user. Set to ./data if you explicitly prefer a bind mount.
ZENTSSH_DATA_VOLUME=zentssh_data

# Public URL when ZentSSH is behind a reverse proxy. Recommended for HTTPS setups.
# BASE_URL=https://ssh.example.com
BASE_URL=

# Comma-separated proxy IPs/CIDRs that are allowed to supply X-Forwarded-* headers.
# Example for a dedicated Docker proxy network: 172.20.0.0/16
TRUSTED_PROXY_CIDRS=

# auto = Secure cookies when the effective request scheme is HTTPS.
# Allowed: auto, true, false
COOKIE_SECURE=auto

# Browser WebSockets send an Origin header. Keep this false unless a trusted
# non-browser client or proxy deliberately removes Origin.
ALLOW_WS_NO_ORIGIN=false

# Web login/session security.
WEB_SESSION_TTL=24h
MAX_WEB_SESSIONS_PER_USER=20
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW=10m
# Global Argon2 work limit for password hash/verify operations.
MAX_PASSWORD_HASH_CONCURRENCY=4

# Detached SSH session lifecycle.
# 0/off = close after the last browser detaches.
# Time values are supported up to 24h; "unlimited" keeps detached sessions
# until explicitly closed or ZentSSH itself restarts.
SSH_SESSION_RETENTION=30m
# Per-session terminal ring buffer in bytes (64 KiB .. 32 MiB).
SESSION_BUFFER_SIZE=2097152
MAX_SESSIONS_PER_USER=8
MAX_TOTAL_SESSIONS=64

# Concurrent server-to-server SFTP streaming transfers.
MAX_TRANSFERS_PER_USER=3
MAX_TOTAL_TRANSFERS=12

# Concurrent interactive SFTP/file operations and idle streaming limits.
MAX_SFTP_OPERATIONS_PER_USER=6
MAX_TOTAL_SFTP_OPERATIONS=48
SFTP_STREAM_IDLE_TIMEOUT=2m

# 0/off disables audit-log retention cleanup.
AUDIT_RETENTION=2160h
